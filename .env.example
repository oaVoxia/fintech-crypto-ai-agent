# Copy to .env.local and fill in values

# Required for the LLM (Vercel AI Gateway recommended)
# AI_GATEWAY_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional for deeper research
# BIGDATA_API_KEY=

# Optional for portfolio persistence (free Upstash Redis)
# Create a free database at https://console.upstash.com/
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
